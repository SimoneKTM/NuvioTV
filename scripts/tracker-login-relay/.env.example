# --- Parametri rete ---
# URL pubblico a cui il relay risponde quando NON è "localhost" (es. su un server: https://mio-relay.example.com)
# IMPORTANTE: il QR lo scansiona il TELEFONO, quindi l'URL nel QR deve essere
# raggiungibile dal telefono. In test locale su device reale usa l'IP LAN del PC
# (es. http://192.168.1.10:8000) - MA il redirect_uri che ne deriva
# ({BASE}/callback/provider) deve corrispondere ESATTAMENTE a quello registrato
# sul provider. Con solo l'emulatore (10.0.2.2) lascia vuoto.
PUBLIC_BASE_URL=

# Base dei redirect_uri. Default: PUBLIC_BASE_URL. Si cambia quando il relay sta dietro un path.
REDIRECT_URI_BASE=

# --- Credenziali provider (opzionali per il test, necessarie per l'accesso vero) ---
# MyAnimeList - OAuth2 con PKCE. Registra un'app: https://myanimelist.net/apiconfig
# redirect_uri da usare (deve corrispondere esattamente): {REDIRECT_URI_BASE}/callback/mal
# client_secret: richiesto per i client creati dal 2025 (confidential); lascia vuoto per i vecchi PKCE-only.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# AniList - OAuth2 Authorization Code Grant (NON è login implicito).
# Registra un'app: https://anilist.co/settings/developer
# redirect_uri da usare (deve corrispondere esattamente): {REDIRECT_URI_BASE}/callback/anilist
# client_secret: obbligatorio solo per client "confidential"; i client pubblici
# devono LASCIARLO VUOTO (se presente il token exchange fallisce).
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Kitsu - Kitsu NON supporta più l'authorization code: l'utente accede con
# username+password su una pagina del relay (/kitsu-login), che usa il
# password grant con il client condiviso.
KITSU_CLIENT_ID=
KITSU_CLIENT_SECRET=