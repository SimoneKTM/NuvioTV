# --- Parametri rete ---
# URL pubblico a cui il relay risponde quando NON è "localhost" (es. su un server: https://mio-relay.example.com)
# In locale, per test con emulatore Android: lasciare vuoto (default http://localhost:8000).
PUBLIC_BASE_URL=

# Base dei redirect_uri. Default: PUBLIC_BASE_URL. Si cambia quando il relay sta dietro un path.
REDIRECT_URI_BASE=

# --- Credenziali provider (opzionali per il test, necessarie per l'accesso vero) ---
# MyAnimeList - OAuth2 (no secret, PKCE). Registra un'app: https://myanimelist.net/apiconfig
# redirect_uri da usare: {REDIRECT_URI_BASE}/callback/mal
MAL_CLIENT_ID=

# AniList - login implicito. Registra un'app: https://anilist.co/settings/developer (Client ID)
# redirect_uri da usare: {REDIRECT_URI_BASE}/callback/anilist
ANILIST_CLIENT_ID=

# Kitsu - OAuth2. Registra un client: https://kitsu.app/api/oauth/applications
# redirect_uri da usare: {REDIRECT_URI_BASE}/callback/kitsu
KITSU_CLIENT_ID=
KITSU_CLIENT_SECRET=